<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Version>10.0.2</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.EsrpSign.SDK</AssemblyName>
    <RootNamespace>Aiursoft.EsrpSign.SDK</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Aiursoft</Company>
    <Product>Aiursoft.EsrpSign.SDK</Product>
    <Description>Create company OpenPGP keys, sign release files, and download verification keys.</Description>
    <PackageId>Aiursoft.EsrpSign.SDK</PackageId>
    <PackageTags>aiursoft esrpsign sdk openpgp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitlab.aiursoft.com/aiursoft/esrpsign</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://gitlab.aiursoft.com/aiursoft/esrpsign.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="." />
    <PackageReference Include="Aiursoft.AiurProtocol" Version="10.0.34" />
  </ItemGroup>
</Project>
