@using Aiursoft.WebTools
@model Aiursoft.EsrpSign.Models.ApiKeysViewModels.IndexViewModel

<div id="esrp-loc-data" hidden
     data-copied="@Localizer["Copied"]"
     data-show-passphrase="@Localizer["Show passphrase"]"
     data-hide-passphrase="@Localizer["Hide passphrase"]"></div>

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">@Localizer["API Keys"]</h1>
            <p class="text-muted mb-0">
                @Localizer["Personal Bearer tokens for CI pipelines and automated signing."]
            </p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="align-middle me-1" data-lucide="plus" style="width:16px;height:16px;"></i>
            @Localizer["Create New API Key"]
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.NewKey))
    {
        <div class="alert alert-success mb-4" role="alert">
            <div class="alert-icon">
                <i class="align-middle" data-lucide="check-circle-2"></i>
            </div>
            <div class="alert-message w-100">
                <p class="fw-semibold mb-2">@Localizer["Copy this key now. It will not be shown again."]</p>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <code id="new-api-key-value" class="text-break bg-body px-2 py-1 rounded border">@Model.NewKey</code>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-copy-target="new-api-key-value" data-restore-class="btn-outline-primary">
                        <span data-copy-label>@Localizer["Copy"]</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="alert alert-info mb-4" role="alert">
        <div class="alert-icon">
            <i class="align-middle" data-lucide="info"></i>
        </div>
        <div class="alert-message">
            @Localizer["An API key inherits the same permissions as its owner. Send it via"] <code>Authorization: Bearer &lt;ESRP_API_KEY&gt;</code>.
        </div>
    </div>

    <div class="card">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Key"]</th>
                    <th>@Localizer["Created"]</th>
                    <th>@Localizer["Expiration"]</th>
                    <th>@Localizer["Status"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var key in Model.ApiKeys)
                {
                    var isExpired = key.ExpirationTime <= DateTime.UtcNow;
                    <tr>
                        <td class="fw-semibold">@key.Name</td>
                        <td><code>@(key.Prefix)...</code></td>
                        <td><label data-utc-time="@key.CreatedAt.ToHtmlDateTime()" class="mb-0"></label></td>
                        <td><label data-utc-time="@key.ExpirationTime.ToHtmlDateTime()" class="mb-0"></label></td>
                        <td>
                            @if (isExpired)
                            {
                                <span class="badge bg-secondary-subtle text-secondary">@Localizer["Expired"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">@Localizer["Active"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="Revoke" asp-route-id="@key.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Revoke"]</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.ApiKeys.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">@Localizer["No API keys yet."]</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/esrp-ui.js" asp-append-version="true"></script>
}
