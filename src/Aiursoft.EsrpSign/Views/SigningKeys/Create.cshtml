@model Aiursoft.EsrpSign.Models.SigningKeysViewModels.CreateViewModel

<div id="esrp-loc-data" hidden
     data-copied="@Localizer["Copied"]"
     data-show-passphrase="@Localizer["Show passphrase"]"
     data-hide-passphrase="@Localizer["Hide passphrase"]"></div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="align-middle me-1" data-lucide="arrow-left" style="width:14px;height:14px;"></i>
        @Localizer["Back to Signing Keys"]
    </a>
</div>

<div class="mb-4">
    <h1 class="h3 mb-1">@Localizer["Create Company Signing Key"]</h1>
    <p class="text-muted mb-0">
        @Localizer["Generate a new OpenPGP signing key pair protected by both the server key ring and your Argon2id passphrase."]
    </p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title mb-0">@Localizer["Key Configuration"]</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" autocomplete="off">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">@Localizer["Key Name"]</label>
                        <input asp-for="Name" class="form-control" maxlength="64"
                               placeholder="@Localizer["e.g. anduinos-release-2026"]" required />
                        <div class="form-text">
                            @Localizer["A human-readable label displayed alongside the public key and OpenPGP fingerprint."]
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Passphrase" class="form-label fw-semibold">@Localizer["Argon2 Key Passphrase"]</label>
                        <div class="input-group">
                            <input asp-for="Passphrase" id="create-passphrase-input" type="password" value=""
                                   autocomplete="new-password" minlength="12" maxlength="256"
                                   aria-describedby="passphrase-help" class="form-control"
                                   placeholder="@Localizer["At least 12 characters"]" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    data-toggle-password="create-passphrase-input"
                                    aria-label="@Localizer["Show passphrase"]" aria-pressed="false">
                                <span data-icon-show><i class="align-middle" data-lucide="eye" style="width:16px;height:16px;"></i></span>
                                <span data-icon-hide class="d-none"><i class="align-middle" data-lucide="eye-off" style="width:16px;height:16px;"></i></span>
                            </button>
                        </div>
                        <div id="passphrase-help" class="form-text">
                            @Localizer["Use 12 to 256 UTF-8 bytes. Store it in your company password manager — it cannot be recovered if lost."]
                        </div>
                        <span asp-validation-for="Passphrase" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassphrase" class="form-label fw-semibold">@Localizer["Confirm Passphrase"]</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassphrase" id="create-confirm-passphrase-input" type="password" value=""
                                   autocomplete="new-password" minlength="12" maxlength="256" class="form-control"
                                   placeholder="@Localizer["Re-enter the exact same passphrase"]" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    data-toggle-password="create-confirm-passphrase-input"
                                    aria-label="@Localizer["Show passphrase"]" aria-pressed="false">
                                <span data-icon-show><i class="align-middle" data-lucide="eye" style="width:16px;height:16px;"></i></span>
                                <span data-icon-hide class="d-none"><i class="align-middle" data-lucide="eye-off" style="width:16px;height:16px;"></i></span>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassphrase" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="align-middle me-1" data-lucide="key-round" style="width:16px;height:16px;"></i>
                            @Localizer["Create Signing Key"]
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="card-title mb-0">
                    <i class="align-middle me-1 text-primary" data-lucide="shield-check" style="width:18px;height:18px;"></i>
                    @Localizer["Three-Layer Protection"]
                </h2>
            </div>
            <div class="card-body">
                <ol class="ps-3 mb-3">
                    <li class="mb-2">
                        <strong>@Localizer["Argon2id + AES-256-GCM"]</strong>:
                        <span class="text-muted">@Localizer["Your passphrase derives a high-cost key that encrypts the OpenPGP private key before storage."]</span>
                    </li>
                    <li class="mb-2">
                        <strong>@Localizer["Server Data Protection"]</strong>:
                        <span class="text-muted">@Localizer["The encrypted envelope is wrapped again by this server's Data Protection key ring."]</span>
                    </li>
                    <li>
                        <strong>@Localizer["Zero Passphrase Retention"]</strong>:
                        <span class="text-muted">@Localizer["The passphrase is never saved or logged. Plaintext key material is wiped from memory right after each operation."]</span>
                    </li>
                </ol>
                <div class="alert alert-warning mb-0" role="alert">
                    <div class="alert-icon">
                        <i class="align-middle" data-lucide="alert-triangle"></i>
                    </div>
                    <div class="alert-message">
                        @Localizer["After creating the key, you will be taken to its Details page where you can copy the Key ID and immediately test your passphrase."]
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/esrp-ui.js" asp-append-version="true"></script>
}
